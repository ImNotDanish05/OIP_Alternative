[node name="Simulation" type="Node3D" unique_id=1577505749]
metadata/oip_st_program = "FUNCTION_BLOCK PalletTruck
VAR_INPUT
  Enable   : BOOL;
  Request  : BOOL;
  Idle     : BOOL;
  Grant    : BOOL;
  PickBase : INT;
  WayBase  : INT;
  WayOut   : INT;
  WayMid   : INT;
  WayIn    : INT;
  DropBase : INT;
  Slots    : INT;
END_VAR
VAR_OUTPUT
  Cmd  : INT;
  Exec : BOOL;
  Fork : BOOL;
  Want : BOOL;
  Step : INT;
  Slot : INT;
  Done : BOOL;
END_VAR
VAR
  Moving  : BOOL;
  Started : BOOL;
  Send    : INT;
  wi      : INT;
  Lift    : TON;
  Drop    : TON;
END_VAR

IF Moving THEN
  IF NOT Idle THEN Started := TRUE; END_IF;
  IF Started THEN Exec := FALSE; END_IF;
  IF Started AND Idle THEN Moving := FALSE; END_IF;
END_IF;

Lift(IN := Enable AND (Step = 20) AND NOT Moving, PT := T#600ms);
Drop(IN := Enable AND (Step = 30) AND NOT Moving, PT := T#600ms);

Send := -1;
IF Enable THEN
  CASE Step OF
    0:  IF Request AND Idle AND NOT Done THEN Want := TRUE;         Step := 5;  END_IF;
    5:  IF Grant THEN wi := 0;                                      Step := 6;  END_IF;
    6:  IF NOT Moving THEN
          IF wi < WayOut THEN  Send := WayBase + wi; wi := wi + 1;
          ELSE                 Send := PickBase;                    Step := 12; END_IF;
        END_IF;
    12: IF NOT Moving THEN     Send := PickBase + 1;                Step := 14; END_IF;
    14: IF NOT Moving THEN     Send := PickBase + 2;                Step := 16; END_IF;
    16: IF NOT Moving THEN     Send := PickBase + 3;                Step := 20; END_IF;
    20: IF NOT Moving THEN
          Fork := TRUE;
          IF Lift.Q THEN       Send := PickBase + 4; wi := 0;       Step := 22; END_IF;
        END_IF;
    22: IF NOT Moving THEN
          IF wi < WayMid THEN  Send := WayBase + WayOut + wi; wi := wi + 1;
          ELSE                 Send := DropBase + 4 * Slot;         Step := 24; END_IF;
        END_IF;
    24: IF NOT Moving THEN     Send := DropBase + 4 * Slot + 1;     Step := 25; END_IF;
    25: IF NOT Moving THEN     Send := DropBase + 4 * Slot + 2;     Step := 30; END_IF;
    30: IF NOT Moving THEN
          Fork := FALSE;
          IF Drop.Q THEN       Send := DropBase + 4 * Slot + 3; wi := 0; Step := 32; END_IF;
        END_IF;
    32: IF NOT Moving THEN
          IF wi < WayIn THEN   Send := WayBase + WayOut + WayMid + wi; wi := wi + 1;
          ELSE
            Slot := Slot + 1;
            IF Slot > Slots - 1 THEN Slot := Slots - 1; Done := TRUE; END_IF;
            Send := 0;                                             Step := 40;
          END_IF;
        END_IF;
    40: IF NOT Moving THEN      Want := FALSE;                      Step := 0;  END_IF;
  END_CASE;
END_IF;
IF Send >= 0 THEN
  Cmd := Send; Exec := TRUE; Moving := TRUE; Started := FALSE;
END_IF;
END_FUNCTION_BLOCK

VAR_INPUT
  Start      : BOOL;
  Stop       : BOOL := TRUE;
  Guard      : BOOL := TRUE;
  BoxAtEye   : BOOL;
  RowReady   : BOOL;
  LayerReady : BOOL;
  ArmIdle    : BOOL;
  TurnDone   : BOOL := TRUE;
  TurnEye    : BOOL;
  LaneAFull  : BOOL;
  LaneBFull  : BOOL;
  Agv1Idle   : BOOL := TRUE;
  Agv2Idle   : BOOL := TRUE;
END_VAR
VAR_OUTPUT
  Infeed     : REAL;
  RowForm    : REAL;
  ShiftSpeed : REAL;
  SpawnRun   : BOOL;
  Turn       : BOOL;
  Shift      : BOOL;
  ArmCmd     : INT;
  ArmExec    : BOOL;
  ArmVac     : BOOL;
  PalletOut  : REAL;
  TurnRun    : REAL;
  TurnCmd    : REAL;
  LaneA      : REAL;
  LaneB      : REAL;
  Agv1Cmd    : INT;
  Agv1Exec   : BOOL;
  Agv1Fork   : BOOL;
  Agv2Cmd    : INT;
  Agv2Exec   : BOOL;
  Agv2Fork   : BOOL;
  PalletFeed : BOOL;
  RunLamp    : BOOL;
  Tower      : INT;
  (* Cases counted at the release eye since the run started. An OUTPUT because something outside the program
     reads it: the scene's infeed annotation puts it on the layout. *)
  Cases      : DINT;
END_VAR
VAR
  running    : BOOL := TRUE;

  InfeedSpeed : REAL := 1.0;
  RunSpeed   : REAL := 1.0;
  ShiftRate  : REAL := 1.0;
  safe       : BOOL;

  Arrival    : R_TRIG;
  rowPhase   : INT;
  rowsPushed : INT;
  turnedFirst : BOOL;
  thisRowTurned : BOOL;
  rowTarget  : INT;
  rowSent    : INT;
  RowPacked  : TON;
  rowDone    : BOOL;
  shifting   : BOOL;
  ShiftPulse : TON;
  Raised     : TON;
  Pushing    : R_TRIG;
  Shifted    : R_TRIG;
  layerDone  : BOOL;

  Step       : INT;
  OutStep    : INT := 100;
  Moving     : BOOL;
  Started    : BOOL;
  PickDwell  : TON;
  PlaceDwell : TON;
  FeedPulse  : TON;
  TurnSettle : TON;

  layerIdx   : INT;
  placeIdx   : INT;
  palletFull : BOOL := TRUE;
  picking    : BOOL;

  LineSpeed  : REAL := 0.4;

  laneSel    : INT := 1;
  outRun     : BOOL;
  laneRun    : BOOL;

  Truck1     : PalletTruck;
  Truck2     : PalletTruck;
  Zone       : INT;
  A1Step     : INT;
  A1Slot     : INT;
  A1Done     : BOOL;
  A2Step     : INT;
  A2Slot     : INT;
  A2Done     : BOOL;
END_VAR

running := (Start OR running) AND Stop;
safe := running AND Guard;

turnedFirst := (layerIdx MOD 2) = 1;
IF turnedFirst THEN
  thisRowTurned := rowPhase = 0;
ELSE
  thisRowTurned := rowPhase = 1;
END_IF;
IF thisRowTurned THEN
  rowTarget := 3;
ELSE
  rowTarget := 2;
END_IF;
Arrival(CLK := BoxAtEye);
IF Arrival.Q THEN
  rowSent := rowSent + 1;
  (* Cumulative production count, on the SAME edge the row logic already uses - a real line counts product
     at a photo-eye, not by asking the machine that made it. DINT, not INT: at 30 cases/min a 16-bit count
     would wrap after about 18 hours of running, which is exactly the kind of number nobody checks. *)
  Cases := Cases + 1;
END_IF;

RowPacked(IN := RowReady AND (rowSent >= rowTarget) AND NOT shifting AND NOT picking, PT := T#1000ms);

rowDone := RowPacked.Q AND (rowsPushed < 2) AND NOT shifting;
shifting := (rowDone OR shifting) AND NOT ShiftPulse.Q;

ShiftPulse(IN := shifting, PT := T#2000ms);

Raised(IN := shifting, PT := T#200ms);

Pushing(CLK := shifting);
IF Pushing.Q AND (rowsPushed = 0) THEN
  rowPhase := 1;
  rowSent := 0;
END_IF;
Shifted(CLK := ShiftPulse.Q);
IF Shifted.Q THEN
  rowsPushed := rowsPushed + 1;
  IF rowsPushed >= 2 THEN
    rowSent := 0;
  END_IF;
END_IF;

layerDone := (rowsPushed >= 2) AND LayerReady;

IF Moving THEN
  IF NOT ArmIdle THEN Started := TRUE; END_IF;
  IF Started THEN ArmExec := FALSE; END_IF;
  IF Started AND ArmIdle THEN Moving := FALSE; END_IF;
END_IF;
PickDwell(IN := safe AND (Step = 20) AND NOT Moving, PT := T#400ms);
PlaceDwell(IN := safe AND (Step = 50) AND NOT Moving, PT := T#400ms);

FeedPulse(IN := PalletFeed, PT := T#1000ms);
TurnSettle(IN := OutStep = 115, PT := T#1200ms);

IF safe THEN
  CASE Step OF
    0:  picking := FALSE;
        IF layerDone AND NOT palletFull THEN
          placeIdx := layerIdx;
          ArmCmd := 1; ArmExec := TRUE; Moving := TRUE; Started := FALSE; picking := TRUE; Step := 10;
        END_IF;
    10: IF NOT Moving THEN
          ArmCmd := 2; ArmExec := TRUE; Moving := TRUE; Started := FALSE; Step := 20;
        END_IF;
    20: IF NOT Moving THEN
          ArmVac := TRUE;
          IF PickDwell.Q THEN
            ArmCmd := 1; ArmExec := TRUE; Moving := TRUE; Started := FALSE; Step := 30;
          END_IF;
        END_IF;
    30: IF NOT Moving THEN
          rowPhase := 0;
          rowSent := 0;
          rowsPushed := 0;
          picking := FALSE;
          layerIdx := layerIdx + 1;
          IF layerIdx >= 3 THEN layerIdx := 0; END_IF;
          ArmCmd := 3; ArmExec := TRUE; Moving := TRUE; Started := FALSE; Step := 40;
        END_IF;
    40: IF NOT Moving THEN
          ArmCmd := 4 + placeIdx; ArmExec := TRUE; Moving := TRUE; Started := FALSE; Step := 50;
        END_IF;
    50: IF NOT Moving THEN
          ArmVac := FALSE;
          IF PlaceDwell.Q THEN
            ArmCmd := 3; ArmExec := TRUE; Moving := TRUE; Started := FALSE; Step := 60;
          END_IF;
        END_IF;
    60: IF NOT Moving THEN
          IF placeIdx >= 2 THEN
            IF OutStep = 0 THEN
              palletFull := TRUE;
              OutStep := 100;
              ArmCmd := 0; ArmExec := TRUE; Moving := TRUE; Started := FALSE; Step := 0;
            END_IF;
          ELSE
            ArmCmd := 0; ArmExec := TRUE; Moving := TRUE; Started := FALSE; Step := 0;
          END_IF;
        END_IF;
  END_CASE;

  CASE OutStep OF
    100: IF (laneSel = 0) AND NOT LaneAFull THEN
           TurnCmd := 0.0; OutStep := 105;
         ELSIF (laneSel = 1) AND NOT LaneBFull THEN
           TurnCmd := 0.0; OutStep := 105;
         ELSIF NOT LaneAFull THEN
           laneSel := 0; TurnCmd := 0.0; OutStep := 105;
         ELSIF NOT LaneBFull THEN
           laneSel := 1; TurnCmd := 0.0; OutStep := 105;
         END_IF;
    105: IF TurnDone THEN outRun := TRUE; OutStep := 110; END_IF;
    110: IF TurnEye THEN
           outRun := FALSE;
           IF laneSel = 1 THEN
             OutStep := 115;
           ELSE
             TurnCmd := 0.0;
             PalletFeed := TRUE;
             OutStep := 120;
           END_IF;
         END_IF;
    115: IF TurnSettle.Q THEN
           TurnCmd := -90.0;
           PalletFeed := TRUE;
           OutStep := 120;
         END_IF;
    120: IF TurnDone THEN laneRun := TRUE; OutStep := 130; END_IF;
    130: IF ((laneSel = 0) AND LaneAFull) OR ((laneSel = 1) AND LaneBFull) THEN
           laneRun := FALSE;
           TurnCmd := 0.0;
           OutStep := 140;
         END_IF;
    140: IF TurnDone THEN
           laneSel := 1 - laneSel;
           OutStep := 0;
         END_IF;
  END_CASE;
  IF PalletFeed AND FeedPulse.Q THEN
    PalletFeed := FALSE;
    palletFull := FALSE;
  END_IF;
END_IF;

IF Zone = 0 THEN
  IF Truck1.Want THEN Zone := 1; ELSIF Truck2.Want THEN Zone := 2; END_IF;
ELSIF (Zone = 1) AND NOT Truck1.Want THEN Zone := 0;
ELSIF (Zone = 2) AND NOT Truck2.Want THEN Zone := 0;
END_IF;

Truck1(Enable := safe, Idle := Agv1Idle, Grant := (Zone = 1),
       Request := LaneAFull AND NOT (laneRun AND (laneSel = 0)),
       PickBase := 1, WayBase := 6,
       WayOut := 0, WayMid := 2, WayIn := 2,
       DropBase := 10, Slots := 3);
Agv1Cmd := Truck1.Cmd; Agv1Exec := Truck1.Exec; Agv1Fork := Truck1.Fork;
A1Step := Truck1.Step; A1Slot := Truck1.Slot; A1Done := Truck1.Done;

Truck2(Enable := safe, Idle := Agv2Idle, Grant := (Zone = 2),
       Request := LaneBFull AND NOT (laneRun AND (laneSel = 1)),
       PickBase := 1, WayBase := 6,
       WayOut := 1, WayMid := 1, WayIn := 0,
       DropBase := 8, Slots := 2);
Agv2Cmd := Truck2.Cmd; Agv2Exec := Truck2.Exec; Agv2Fork := Truck2.Fork;
A2Step := Truck2.Step; A2Slot := Truck2.Slot; A2Done := Truck2.Done;

IF safe AND NOT picking THEN
  Infeed := InfeedSpeed;
  RowForm := RunSpeed;
ELSE
  Infeed := 0.0;
  RowForm := 0.0;
END_IF;
IF safe AND shifting AND Raised.Q THEN
  ShiftSpeed := ShiftRate;
ELSE
  ShiftSpeed := 0.0;
END_IF;

SpawnRun := safe AND NOT layerDone AND NOT picking AND (rowSent < rowTarget);

IF safe AND outRun THEN PalletOut := LineSpeed; ELSE PalletOut := 0.0; END_IF;
IF safe AND (outRun OR laneRun) THEN TurnRun := LineSpeed; ELSE TurnRun := 0.0; END_IF;
IF safe AND laneRun AND (laneSel = 0) THEN LaneA := LineSpeed; ELSE LaneA := 0.0; END_IF;
IF safe AND laneRun AND (laneSel = 1) THEN LaneB := LineSpeed; ELSE LaneB := 0.0; END_IF;

Turn := safe AND thisRowTurned;
Shift := shifting AND safe;

RunLamp := safe AND NOT palletFull;
Tower := 0;
IF RunLamp THEN Tower := Tower + 1; END_IF;
IF palletFull THEN Tower := Tower + 2; END_IF;
IF (NOT running) OR (NOT Guard) THEN Tower := Tower + 4; END_IF;
"
metadata/oip_st_scan_ms = 10

